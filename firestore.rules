rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin = correo autorizado (misma lista que el panel usa para el rol admin).
    // El bot de WhatsApp opera por el backend (Admin SDK) y no depende de estas reglas.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'admin@fitia.com',
        'mysterrpj@gmail.com',
        'prueba@test.com'
      ];
    }

    // Miembros: el admin ve todo; cada usuario solo ve/escribe su propio doc
    // (el que crea el registro) y no puede asignarse rol admin.
    match /members/{document} {
      allow read: if isAdmin() || request.auth.uid == document;
      allow create: if isAdmin() || (request.auth.uid == document && request.resource.data.role == 'user');
      allow update: if isAdmin() || (request.auth.uid == document && request.resource.data.role == 'user');
      allow delete: if isAdmin();
    }

    // Colecciones administrativas: solo admin.
    match /memberships/{document} {
      allow read, write: if isAdmin();
    }
    match /classes/{document} {
      allow read, write: if isAdmin();
    }
    match /bookings/{document} {
      allow read, write: if isAdmin();
    }
    match /payments/{document} {
      allow read, write: if isAdmin();
    }
    match /messages/{document} {
      allow read, write: if isAdmin();
    }
    match /config/{document} {
      allow read, write: if isAdmin();
    }
    match /settings/{document} {
      allow read, write: if isAdmin();
    }
    match /accessLogs/{document} {
      allow read, write: if isAdmin();
    }
    match /studentRoutineAssignments/{document} {
      allow read, write: if isAdmin();
    }
  }
}
