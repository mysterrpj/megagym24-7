# Modo de prueba local contra el Firebase Emulator Suite.
# Se carga solo con: npm run dev:emulator
# No contiene secretos: los emuladores aceptan credenciales ficticias.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-megagym.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-megagym
VITE_FIREBASE_STORAGE_BUCKET=demo-megagym.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
